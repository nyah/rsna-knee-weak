  {"name": "r18_focal",    "config": "resnet18_base", "set": {"loss": "focal"},     "factor": "pérdida"},
  {"name": "r18_conf",     "config": "resnet18_base", "set": {"noise": "conf"},     "factor": "ruido"},
  {"name": "r18_highconf", "config": "resnet18_base", "set": {"noise": "highconf"}, "factor": "ruido"},
  {"name": "r18_nopw",     "config": "resnet18_base", "set": {"pos_weight": "none"}, "factor": "desbalance"},
  {"name": "r50",          "config": "resnet18_base", "set": {"model": "resnet50"}, "factor": "profundidad"},
  {"name": "r18_seed1",    "config": "resnet18_base", "set": {"seed": 1},           "factor": "semilla"},
  {"name": "r18_seed2",    "config": "resnet18_base", "set": {"seed": 2},           "factor": "semilla"},
